<Window x:Class="Shuyu.Controls.HotkeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotkey"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="420"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="DescText" Grid.Row="0" TextWrapping="Wrap"/>

        <Border Grid.Row="1" Margin="0,12,0,8" Padding="8" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6">
            <StackPanel Orientation="Vertical">
                <TextBlock x:Name="CurrentText" FontSize="16"/>
                <TextBlock x:Name="ErrorText" Foreground="IndianRed" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" >
            <Button x:Name="ResetButton" Width="80" Margin="0,0,8,0"/>
            <Button x:Name="CancelButton" Width="80" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Width="100"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Text=""/>
    </Grid>
</Window>